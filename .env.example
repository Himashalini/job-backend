# Backend environment variables example
# Copy to .env in the backend folder and provide real values on the server (do NOT commit .env)

# Database (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=jobdb
DB_PORT=3306
DB_SSL=false
# Set DB_SSL=true for cloud databases that require TLS/SSL.
# If your cloud provider requires an SSL CA certificate, set DB_SSL_CA to the PEM text.
# If you want to allow TLS without a CA certificate, set DB_SSL_REJECT_UNAUTHORIZED=false.
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# JWT secret for signing tokens
JWT_SECRET=replace_with_a_strong_secret

# Server port (default 5000)
PORT=5000

# Optional: cloudinary or storage credentials
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Other service credentials (example)
# SENDGRID_API_KEY=
